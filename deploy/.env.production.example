# Production environment for the single-VPS deployment.
#
# Copy to .env and fill in real values:
#   cp .env.production.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# All values are required unless marked OPTIONAL.

# ── Domain & TLS ─────────────────────────────────────────────────────
# The fully-qualified domain pointing at this VPS (A record at your DNS).
DOMAIN=arena.example.com
# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=ops@example.com
# Traefik's Docker provider hardcodes an old API version. Modern Docker
# daemons (>=29.x) reject it. Set this to your host's `docker version`
# Server API version (e.g. 1.55 on Docker 29.x). Anything ≥ 1.40 works.
DOCKER_API_VERSION=1.55

# ── Image version ───────────────────────────────────────────────────
# Which release of the arena images to pull from Docker Hub
# (her3ert/outplayarena-*). Pin a specific release (e.g. v0.2.1) for
# stability, or set to `latest` to track the rolling release. See
# .github/workflows/release.yml.
IMAGE_TAG=v0.2.1

# ── Database ─────────────────────────────────────────────────────────
# Username/password for the Postgres container. The backend constructs
# the connection URL from these — do not also set DATABASE_URL.
POSTGRES_USER=outplayarena
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING_32_CHARS_MIN
POSTGRES_DB=outplayarena

# ── Redis ───────────────────────────────────────────────────────────
# Password for the Redis container. The backend's REDIS_URL in the compose
# file is already templated to use this. Generate with:
#   openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING_32_CHARS_MIN

# ── JWT / Sessions ──────────────────────────────────────────────────
# Long random string used to sign JWTs and (by default) session keys.
# Generate with:  openssl rand -hex 32
# The backend refuses to start if this is set to the insecure default.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_64_HEX_CHARS

# SESSION_KEY_SECRET (OPTIONAL) — signs game session keys (nks_...) separately
# from JWTs. Falls back to JWT_SECRET when unset. Set independently to allow
# rotating one secret without invalidating the other.
# Generate with:  openssl rand -hex 32
# SESSION_KEY_SECRET=CHANGE_ME_SEPARATE_64_HEX_CHARS

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS. Must be set to your
# domain in production — Starlette's wildcard+credentials combination echoes
# back any Origin header, which allows cross-site authenticated requests.
CORS_ALLOW_ORIGINS=https://arena.example.com

# ── OAuth (OPTIONAL) ────────────────────────────────────────────────
# GitHub OAuth app. Register at https://github.com/settings/developers
# Callback URL: https://${DOMAIN}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth. Register at https://console.cloud.google.com/apis/credentials
# Callback URL: https://${DOMAIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAUTH_ALLOWED_BASES — comma-separated origins allowed as the OAuth redirect_uri
# base. Prevents Host-header injection from hijacking OAuth callbacks.
# Must match your public domain. Set automatically in docker-compose from ${DOMAIN}.
OAUTH_ALLOWED_BASES=https://arena.example.com

# ── Traefik Dashboard ───────────────────────────────────────────────
# Basic-auth user:hash for the Traefik dashboard at https://traefik.${DOMAIN}
# The dashboard port (8080) is now bound to 127.0.0.1 only — access it via
# SSH tunnel:  ssh -L 8080:localhost:8080 arena@<vps>
# Generate with:  htpasswd -nb admin your_password_here
# The htpasswd output starts with "admin:$apr1$..." — paste the whole thing.
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGE_ME_HASH_FROM_HTPASSWD

# ── Backups ────────────────────────────────────────────────────────
# Optional: directory where backup.sh writes GFS-rotation snapshots.
# Leave empty to disable local backups (restic-only deployments ignore this).
# Any writable path works — a Hetzner Cloud Volume mount, an NFS share,
# a local SSD subdir, etc. The script creates ${BACKUP_DIR}/{daily,weekly,monthly}/
# on demand and prunes each tier to its single most recent copy.
# Example for the Hetzner Cloud Volume: /mnt/HC_Volume_106157320/arena-backups
BACKUP_DIR=

# ── MCP ─────────────────────────────────────────────────────────────
# MCP_ALLOWED_HOSTS and MCP_ALLOWED_ORIGINS are set in the compose file from
# ${DOMAIN}. Override here only if you need to add extra allowed hosts
# (e.g. a staging domain alongside production):
#   MCP_ALLOWED_HOSTS=arena.example.com,staging.example.com
#   MCP_ALLOWED_ORIGINS=https://arena.example.com,https://staging.example.com
