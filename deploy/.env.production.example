# Production environment for the single-VPS deployment.
#
# Copy to .env and fill in real values:
#   cp .env.production.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# All values are required unless marked OPTIONAL.

# ── Domain & TLS ─────────────────────────────────────────────────────
# The fully-qualified domain pointing at this VPS (A record at your DNS).
DOMAIN=arena.example.com
# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=ops@example.com
# Traefik's Docker provider hardcodes an old API version. Modern Docker
# daemons (>=29.x) reject it. Set this to your host's `docker version`
# Server API version (e.g. 1.55 on Docker 29.x). Anything ≥ 1.40 works.
DOCKER_API_VERSION=1.55

# ── Database ─────────────────────────────────────────────────────────
# Username/password for the Postgres container. The backend constructs
# the connection URL from these — do not also set DATABASE_URL.
POSTGRES_USER=outplayarena
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING_32_CHARS_MIN
POSTGRES_DB=outplayarena

# ── JWT / Sessions ──────────────────────────────────────────────────
# Long random string used to sign session keys. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_64_HEX_CHARS

# ── OAuth (OPTIONAL) ────────────────────────────────────────────────
# GitHub OAuth app. Register at https://github.com/settings/developers
# Callback URL: https://${DOMAIN}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth. Register at https://console.cloud.google.com/apis/credentials
# Callback URL: https://${DOMAIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Traefik Dashboard ───────────────────────────────────────────────
# Basic-auth user:hash for the Traefik dashboard at https://traefik.${DOMAIN}
# Generate with:  htpasswd -nb admin your_password_here
# The htpasswd output starts with "admin:$apr1$..." — paste the whole thing.
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGE_ME_HASH_FROM_HTPASSWD

# ── Backups ────────────────────────────────────────────────────────
# Optional: directory where backup.sh writes GFS-rotation snapshots.
# Leave empty to disable local backups (restic-only deployments ignore this).
# Any writable path works — a Hetzner Cloud Volume mount, an NFS share,
# a local SSD subdir, etc. The script creates ${BACKUP_DIR}/{daily,weekly,monthly}/
# on demand and prunes each tier to its single most recent copy.
# Example for the Hetzner Cloud Volume: /mnt/HC_Volume_106157320/arena-backups
BACKUP_DIR=

# ── MCP ─────────────────────────────────────────────────────────────
# JWT_SECRET is reused for MCP auth. OUTPLAYARENA_BASE_URL is set in the
# compose file to point at the backend container.
