# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://outplayarena:outplayarena@localhost:5432/outplayarena

# ── Pub/Sub (Redis) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ─────────────────────────────────────────────────────────────
API_PREFIX=/api

# ── Agent REST API Access ───────────────────────────────────────────
# Set to "true" to allow external access to game-related REST endpoints
# When "false" (default), only MCP servers with valid auth can access these endpoints
ENABLE_AGENT_REST_API=false

# Comma-separated list of allowed IPs for MCP servers (default: 127.0.0.1)
MCP_ALLOWED_IPS=127.0.0.1

# ── MCP Container Pool ─────────────────────────────────────────────
# Runtime: "auto", "k8s", or "docker"
MCP_RUNTIME=auto

# URL that MCP containers use to reach the backend API
MCP_BACKEND_URL=http://localhost:8000/api

# Docker network name (for Docker runtime)
MCP_DOCKER_NETWORK=arena_default

# Kubernetes namespace (for K8s runtime)
MCP_NAMESPACE=arena

# MCP container image
MCP_IMAGE=arena-mcp:latest

# Maximum concurrent MCP containers
MCP_MAX_CONCURRENT=50

# Seconds before idle MCP container is cleaned up
MCP_JOB_TTL=300

# MCP container port
MCP_PORT=8001

# ── OAuth ───────────────────────────────────────────────────────────
# GitHub OAuth App: https://github.com/settings/developers
#   callback URL: ${OAUTH_CALLBACK_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
#   callback URL: ${OAUTH_CALLBACK_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# change-me-in-production-use-a-long-random-string
# generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production

# Optional. If empty, the backend builds the OAuth callback URL from the
# request's Host header (works for any hostname — Tailscale MagicDNS, LAN
# IPs, localhost). Set this to lock the callback to a single origin in
# production, e.g. https://app.example.com
#
# NOTE: This is read from .env directly, not from your shell environment.
# A stale `export OAUTH_CALLBACK_BASE_URL=...` in your shell is ignored.
# To override, edit this file or unset the shell variable.
OAUTH_CALLBACK_BASE_URL=

# CORS — defaults to "*" for dev. Comma-separated list of allowed origins
# in production, e.g. CORS_ALLOW_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ALLOW_ORIGINS=*

# MCP server URL advertised to the backend. Defaults to the chart's
# in-cluster value; override for local dev with kubectl port-forward.
# In dev with scripts/dev-tunnel.sh running, this is http://localhost:<port>.
MCP_PUBLIC_BASE_URL=

# In-cluster MCP endpoint for the local uvicorn process (used by agents
# that spawn their own MCP sessions). Set to the port-forwarded MCP
# service, e.g. http://localhost:9998 with the default dev-tunnel.sh setup.
MCP_ENDPOINT=
