# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nasharena:nasharena@localhost:5432/nasharena

# ── Pub/Sub (Redis) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ─────────────────────────────────────────────────────────────
API_PREFIX=/api

# ── Agent REST API Access ───────────────────────────────────────────
# Set to "true" to allow external access to game-related REST endpoints
# When "false" (default), only MCP servers with valid auth can access these endpoints
ENABLE_AGENT_REST_API=false

# Comma-separated list of allowed IPs for MCP servers (default: 127.0.0.1)
MCP_ALLOWED_IPS=127.0.0.1

# ── MCP Container Pool ─────────────────────────────────────────────
# Runtime: "auto", "k8s", or "docker"
MCP_RUNTIME=auto

# URL that MCP containers use to reach the backend API
MCP_BACKEND_URL=http://localhost:8000/api

# Docker network name (for Docker runtime)
MCP_DOCKER_NETWORK=nasharena_default

# Kubernetes namespace (for K8s runtime)
MCP_NAMESPACE=nasharena

# MCP container image
MCP_IMAGE=nasharena-mcp:latest

# Maximum concurrent MCP containers
MCP_MAX_CONCURRENT=50

# Seconds before idle MCP container is cleaned up
MCP_JOB_TTL=300

# MCP container port
MCP_PORT=8001

# ── OAuth ───────────────────────────────────────────────────────────
# GitHub OAuth App: https://github.com/settings/developers
#   callback URL: ${OAUTH_CALLBACK_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
#   callback URL: ${OAUTH_CALLBACK_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# change-me-in-production-use-a-long-random-string
# generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production

OAUTH_CALLBACK_BASE_URL=http://localhost:8000
