#!/bin/sh
# Pre-commit: run tests/lint only for changed files

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"

if [ -z "$STAGED" ]; then
  echo "[pre-commit] Nothing staged. Skipping."
  exit 0
fi

# ── Frontend ────────────────────────────────────────────────────────────────

# Paths relative to frontend/ for ESLint and Vitest
FRONTEND_FILES=$(echo "$STAGED" | grep '^frontend/src/' | sed 's|^frontend/||')

if [ -n "$FRONTEND_FILES" ]; then
  cd "$ROOT/frontend"

  if [ ! -d "node_modules" ]; then
    echo "[pre-commit] Installing frontend dependencies..."
    npm ci --ignore-scripts 2>&1 || { echo "npm ci failed"; exit 1; }
  fi

  echo ""
  echo "━━━ TypeScript typecheck ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  ./node_modules/.bin/tsc -b --noEmit 2>&1

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ TypeScript typecheck failed. Commit aborted."
    echo "   Run 'cd frontend && npx tsc -b --noEmit' to see errors."
    exit 1
  fi
  echo "✅ TypeScript typecheck passed."

  echo ""
  echo "━━━ ESLint ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  # Lint only the staged TS/TSX files (instead of the whole tree) so the
  # hook finishes in seconds rather than ~30s for a 1-file change. The
  # cache lets re-runs skip unchanged files entirely. --max-warnings 0
  # makes any warning also fail the commit (the previous setup only
  # failed on errors, which let react-hooks/exhaustive-deps and
  # react-hooks/set-state-in-effect warnings slip through to CI). The
  # `frontend/` prefix is stripped because we're already cd'd into
  # frontend/ for the typecheck step above.
  ESLINT_FILES=$(echo "$STAGED" | grep -E '^frontend/src/.*\.(ts|tsx)$' | sed 's|^frontend/||' || true)

  if [ -n "$ESLINT_FILES" ]; then
    # shellcheck disable=SC2086
    ./node_modules/.bin/eslint --cache --max-warnings 0 $ESLINT_FILES 2>&1
  else
    echo "   (no staged TS/TSX files; skipping ESLint)"
  fi

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ ESLint failed. Commit aborted."
    echo "   Run 'cd frontend && npx eslint <file>' to see errors."
    exit 1
  fi
  echo "✅ ESLint passed."

  cd "$ROOT"
fi

# ── Backend (Python) ────────────────────────────────────────────────────────

PY_CHANGED=$(echo "$STAGED" | grep -c '\.py$' || true)

if [ "$PY_CHANGED" -gt 0 ]; then
  echo ""
  echo "━━━ Python lint ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  PY_FILES=$(echo "$STAGED" | grep '\.py$' | tr '\n' ' ')
  uv run ruff check $PY_FILES 2>&1

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Python lint failed. Commit aborted."
    echo "   Run 'uv run ruff check <file>' to see details."
    exit 1
  fi
  echo "✅ Python lint passed."

  echo ""
  echo "━━━ Python tests ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  uv run pytest 2>&1

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Python tests failed. Commit aborted."
    echo "   Run 'uv run pytest -q' to debug."
    exit 1
  fi
  echo "✅ Python tests passed."
fi

# ── Nothing applicable ──────────────────────────────────────────────────────

if [ -z "$FRONTEND_FILES" ] && [ "$PY_CHANGED" -eq 0 ]; then
  echo "[pre-commit] No frontend or Python changes. Skipping tests."
fi

echo ""
