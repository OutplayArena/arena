{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "arena chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },

    "dev": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "liveReload": { "type": "boolean" },
        "staticSourcePath": { "type": "string" }
      }
    },

    "database": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "type": "string" },
        "database": { "type": "string" },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "storage": { "type": "string" },
        "storageClassName": { "type": "string" },
        "createPV": { "type": "boolean" },
        "volumeName": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },

    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "storage": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },

    "oauth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "callbackBaseUrl": { "type": "string" },
        "githubClientId": { "type": "string" },
        "githubClientSecret": { "type": "string" },
        "googleClientId": { "type": "string" },
        "googleClientSecret": { "type": "string" },
        "jwtSecret": { "type": "string" }
      }
    },

    "backend": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "env": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "apiPrefix": { "type": "string" },
            "enableAgentRestApi": { "type": "string" },
            "enableAdminDashboard": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPU": { "type": "integer", "minimum": 1, "maximum": 100 },
            "targetMemory": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] }
          }
        }
      }
    },

    "mcpServer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "publicBaseUrl": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },

    "migrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/definitions/image" }
      }
    },

    "docs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },

    "traefik": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "certResolver": { "type": "string" },
        "tlsSecret": { "type": "string" },
        "middleware": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rateLimit": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "average": { "type": "integer", "minimum": 0 },
                "burst": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },

  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cpu": { "type": ["number", "string"] },
            "memory": { "type": ["number", "string"] }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cpu": { "type": ["number", "string"] },
            "memory": { "type": ["number", "string"] }
          }
        }
      }
    }
  }
}
